{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vana",
  "version": "0.1.0",
  "identifier": "io.github.burak57sn.vana",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run sidecars && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vana",
        "width": 1080,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Paste a link, open the valve, let Vana handle the rest.",
    "longDescription": "Downloads public video and audio from YouTube, TikTok, Instagram and X links.",
    "copyright": "© 2026 burak57sn. MIT License.",
    "publisher": "burak57sn",
    "homepage": "https://github.com/burak57sn/vana",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/deno"
    ],
    "resources": {
      "binaries/yt-dlp-dist/": "yt-dlp-dist/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
